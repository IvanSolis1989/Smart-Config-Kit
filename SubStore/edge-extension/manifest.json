{
  "manifest_version": 3,
  "name": "Sub-Store 自动订阅同步助手",
  "version": "1.4.1",
  "minimum_chrome_version": "111",
  "description": "在浏览器授权的网站或IP面板自动识别订阅，匹配本机Sub-Store现有名称，验证后自动更新链接。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sub-Store 自动订阅同步",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "local-transport.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
